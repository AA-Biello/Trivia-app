# Copy to .env.local and fill in values from your Supabase project settings.
# Do not commit real credentials. Create the project manually in the Supabase dashboard.

# Project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (anon) key — safe for browser use with RLS enabled
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Service role key — server-only. Never expose to the browser or Client Components.
# Used for host-authoritative writes and reading host-only tables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site origin used for join URLs / QR codes (no trailing slash).
# Falls back to request Host headers when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000
